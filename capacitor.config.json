{
  "appId": "ba.poso.app",
  "appName": "Poso.ba",
  "webDir": "dist",
  "backgroundColor": "#0d2a52",
  "ios": {
    "contentInset": "always",
    "scheme": "Poso.ba",
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0d2a52"
  },
  "server": {
    "url": "https://bilalishakcanada-wq.github.io/websample/",
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#0d2a52",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0d2a52",
      "overlaysWebView": false
    }
  }
}
