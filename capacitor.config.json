{
  "appId": "ba.poso.app",
  "appName": "Zadatak",
  "webDir": "dist",
  "backgroundColor": "#0d2a52",
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#0d2a52"
  },
  "server": {
    "url": "https://bilalishakcanada-wq.github.io/websample/",
    "androidScheme": "https",
    "errorPath": "offline.html"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#0d2a52"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#081b38",
      "overlaysWebView": false
    },
    "SystemBars": {
      "initialViewportFitValueHint": "cover"
    }
  }
}
